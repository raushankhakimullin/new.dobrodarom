# ── Кодировка и MIME-типы ────────────────────────────────────────────────────
AddDefaultCharset UTF-8
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg
AddType image/webp .webp
AddType font/woff2 .woff2

# ── Безопасность ─────────────────────────────────────────────────────────────
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ── Кэширование статики ───────────────────────────────────────────────────────
<FilesMatch "\.(js|css|woff2|jpg|jpeg|png|svg|webp|gif|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# index.html — не кэшировать (чтобы обновления подхватывались сразу)
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# ── GZIP-сжатие ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── SPA — все маршруты → index.html ─────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Пропускаем существующие файлы и директории
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Всё остальное → index.html (React Router / Wouter разберут маршрут)
  RewriteRule ^ index.html [L]
</IfModule>
